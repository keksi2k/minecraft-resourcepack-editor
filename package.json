{
  "name": "minecraft-resourcepack-editor",
  "private": true,
  "version": "1.3.0",
  "description": "Browser-based editor for Minecraft Java Edition resource packs: view items and mobs in 3D, listen to and add sounds, replace textures, export the pack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keksi2k/minecraft-resourcepack-editor.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "vitest run",
    "package": "npm run build && node scripts/package-release.mjs",
    "mc:fetch": "node scripts/fetch-minecraft.mjs",
    "mc:models": "node scripts/update-entity-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
